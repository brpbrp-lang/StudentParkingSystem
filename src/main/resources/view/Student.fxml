<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parking.controller.StudentController"
      spacing="20" styleClass="content-area">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <VBox spacing="12" HBox.hgrow="ALWAYS">
        <Label text="Student Management" styleClass="page-title"/>

        <HBox spacing="8">
            <TextField fx:id="searchField" promptText="Search by ID, name, or course" HBox.hgrow="ALWAYS"/>
            <Button text="Search" onAction="#handleSearch"/>
        </HBox>

        <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="Student ID" prefWidth="110"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="180"/>
                <TableColumn fx:id="colCourse" text="Course" prefWidth="140"/>
                <TableColumn fx:id="colYear" text="Year Level" prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="10" prefWidth="320" styleClass="form-card">
        <Label text="Student Details" styleClass="section-title"/>

        <Label text="Student ID"/>
        <TextField fx:id="idField" promptText="e.g. 2023-00123"/>

        <Label text="Full Name"/>
        <TextField fx:id="nameField" promptText="Juan Dela Cruz"/>

        <Label text="Course"/>
        <TextField fx:id="courseField" promptText="BS Computer Science"/>

        <Label text="Year Level"/>
        <TextField fx:id="yearField" promptText="1-5"/>

        <HBox spacing="10">
            <VBox alignment="CENTER" spacing="4">
                <Label text="Photo"/>
                <ImageView fx:id="photoView" fitWidth="90" fitHeight="90" preserveRatio="true"/>
                <Button text="Choose Photo" onAction="#handleChoosePhoto"/>
            </VBox>
            <VBox alignment="CENTER" spacing="4">
                <Label text="QR Code"/>
                <ImageView fx:id="qrView" fitWidth="90" fitHeight="90" preserveRatio="true"/>
                <Button text="Generate QR" onAction="#handleGenerateQR"/>
            </VBox>
        </HBox>

        <HBox spacing="8">
            <Button text="Add" onAction="#handleAdd" styleClass="primary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Update" onAction="#handleUpdate" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
        <HBox spacing="8">
            <Button text="Delete" onAction="#handleDelete" styleClass="danger-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Clear" onAction="#handleClear" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    </VBox>

</HBox>
