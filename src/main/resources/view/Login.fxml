<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="login-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.parking.controller.LoginController">

    <VBox alignment="CENTER" maxWidth="360" spacing="14" styleClass="login-card">
        <padding>
            <Insets bottom="40" left="40" right="40" top="40" />
        </padding>

        <Label styleClass="login-title" text=" Parking Management System" wrapText="true" />
        <Label styleClass="login-subtitle" text="Administrator Login" />

        <VBox spacing="6">
            <Label text="Username" />
            <TextField fx:id="usernameField" promptText="Enter username" />
        </VBox>

        <VBox spacing="6">
            <Label text="Password" />
            <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Enter password" />
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />

        <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="primary-button" text="Login" />

        <Label styleClass="hint-label" text="Default: admin / 123456" />
    </VBox>

</StackPane>
