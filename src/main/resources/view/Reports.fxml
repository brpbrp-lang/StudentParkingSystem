<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parking.controller.ReportController"
      spacing="14" styleClass="content-area">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <Label text="Reports" styleClass="page-title"/>

    <HBox spacing="10" styleClass="form-card">
        <Button text="Daily Report" onAction="#handleDaily" styleClass="primary-button"/>
        <Button text="Weekly Report" onAction="#handleWeekly" styleClass="primary-button"/>
        <Button text="Monthly Report" onAction="#handleMonthly" styleClass="primary-button"/>
        <VBox HBox.hgrow="ALWAYS"/>
        <Button text="Export to PDF" onAction="#handleExportPDF"/>
        <Button text="Export to Excel" onAction="#handleExportExcel"/>
    </HBox>

    <Label fx:id="reportTitleLabel" text="No report generated yet." styleClass="section-title"/>

    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colLogId" text="Log ID" prefWidth="70"/>
            <TableColumn fx:id="colStudent" text="Student" prefWidth="160"/>
            <TableColumn fx:id="colPlate" text="Vehicle" prefWidth="120"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colTimeIn" text="Time In" prefWidth="100"/>
            <TableColumn fx:id="colTimeOut" text="Time Out" prefWidth="100"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
        </columns>
    </TableView>

</VBox>
