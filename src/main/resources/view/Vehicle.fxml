<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parking.controller.VehicleController"
      spacing="20" styleClass="content-area">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <VBox spacing="12" HBox.hgrow="ALWAYS">
        <Label text="Vehicle Management" styleClass="page-title"/>

        <HBox spacing="8">
            <TextField fx:id="searchField" promptText="Search by plate no., student ID, or brand" HBox.hgrow="ALWAYS"/>
            <Button text="Search" onAction="#handleSearch"/>
        </HBox>

        <TableView fx:id="vehicleTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colVehicleId" text="Vehicle ID" prefWidth="90"/>
                <TableColumn fx:id="colStudentId" text="Student ID" prefWidth="110"/>
                <TableColumn fx:id="colPlate" text="Plate Number" prefWidth="120"/>
                <TableColumn fx:id="colBrand" text="Brand" prefWidth="110"/>
                <TableColumn fx:id="colColor" text="Color" prefWidth="90"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="10" prefWidth="300" styleClass="form-card">
        <Label text="Vehicle Details" styleClass="section-title"/>

        <Label text="Student ID"/>
        <TextField fx:id="studentIdField" promptText="Owner's Student ID"/>

        <Label text="Plate Number"/>
        <TextField fx:id="plateField" promptText="ABC-1234"/>

        <Label text="Brand"/>
        <TextField fx:id="brandField" promptText="Toyota, Honda, etc."/>

        <Label text="Color"/>
        <TextField fx:id="colorField" promptText="Red, Blue, etc."/>

        <Label text="Type"/>
        <ComboBox fx:id="typeCombo" promptText="Select type" maxWidth="Infinity"/>

        <HBox spacing="8">
            <Button text="Add" onAction="#handleAdd" styleClass="primary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Update" onAction="#handleUpdate" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
        <HBox spacing="8">
            <Button text="Delete" onAction="#handleDelete" styleClass="danger-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Clear" onAction="#handleClear" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    </VBox>

</HBox>
