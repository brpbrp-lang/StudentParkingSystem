<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parking.controller.ParkingLogController"
      spacing="14" styleClass="content-area">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <Label text="Parking Logs" styleClass="page-title"/>

    <HBox spacing="10" styleClass="form-card">
        <VBox spacing="4">
            <Label text="Filter by Date"/>
            <DatePicker fx:id="datePicker" onAction="#handleFilterByDate"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Filter by Student (ID or Name)"/>
            <HBox spacing="6">
                <TextField fx:id="studentSearchField" HBox.hgrow="ALWAYS"/>
                <Button text="Go" onAction="#handleFilterByStudent"/>
            </HBox>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Filter by Vehicle (Plate No.)"/>
            <HBox spacing="6">
                <TextField fx:id="vehicleSearchField" HBox.hgrow="ALWAYS"/>
                <Button text="Go" onAction="#handleFilterByVehicle"/>
            </HBox>
        </VBox>
        <VBox alignment="BOTTOM_LEFT">
            <Button text="Clear Filters" onAction="#handleClearFilters"/>
        </VBox>
    </HBox>

    <TableView fx:id="logTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colLogId" text="Log ID" prefWidth="70"/>
            <TableColumn fx:id="colStudent" text="Student" prefWidth="160"/>
            <TableColumn fx:id="colPlate" text="Vehicle" prefWidth="120"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colTimeIn" text="Time In" prefWidth="100"/>
            <TableColumn fx:id="colTimeOut" text="Time Out" prefWidth="100"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
        </columns>
    </TableView>

</VBox>
