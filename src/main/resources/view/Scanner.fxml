<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="kiosk-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.parking.controller.ScannerController">

    <VBox alignment="CENTER" maxWidth="600" spacing="24" styleClass="kiosk-card">
        <padding>
            <Insets bottom="50" left="50" right="50" top="50" />
        </padding>

        <Label styleClass="kiosk-title" text="SCANNER KIOSK" />

        <VBox alignment="CENTER" spacing="10" styleClass="kiosk-scan-area">

            <ImageView fx:id="cameraView" fitHeight="320" fitWidth="500" preserveRatio="true" />

            <Label styleClass="kiosk-instruction" text="Point the QR Code toward the camera" />

        </VBox>


        <Label fx:id="statusLabel" styleClass="ready-status kiosk-status" text="Ready to Scan" />
        <Label fx:id="detailLabel" styleClass="kiosk-detail" text="Scan your Student QR Code to continue." wrapText="true" />

        <!-- Hidden-in-plain-sight input: a USB QR scanner acts like a keyboard and types
             here automatically, followed by Enter. Kept visible + focused for kiosk operators
             who may need to type an ID manually as a fallback. -->
        <TextField fx:id="qrInputField" managed="false" onAction="#handleScan" promptText="Scan QR code here..." styleClass="kiosk-input" visible="false" />
    </VBox>

</StackPane>
